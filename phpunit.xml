<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- The suite runs in ONE process and compiled Blade views accumulate;
             it crossed the CLI's 128M default at ~550 tests and died mid-run,
             which reads as a broken view rather than an exhausted limit. -->
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Fixtures seed 2025 throughout, and the calendar's last-resort
             fallback is config('cfb.season'). Left unpinned, bumping .env for
             a new season silently moved every default year in the suite. -->
        <env name="CFB_SEASON" value="2025"/>
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_DATABASE" value="campusfootball_test"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <!-- Pinned for the same reason as CFB_SEASON: left unpinned it inherits
             whatever the developer's .env says, so configuring a real bucket
             locally broke a test that had nothing to do with buckets. Anything
             wanting the R2 shape sets it per test. -->
        <env name="UPLOAD_DISK" value="public"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <!-- The funnel counters are real Redis hashes, not a cache abstraction,
             so the suite would otherwise write test counts into the telemetry
             database a developer is also using — and `cfb:ux-rollup` would
             then persist them. DB 15 is the suite's own; nothing else uses it. -->
        <env name="REDIS_PULSE_DB" value="15"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>

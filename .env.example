APP_NAME="Campus Football"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://campusfootball.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=UTC

# All contest scheduling, locking, and slate eligibility is evaluated in this
# zone, never in UTC. CFB season spans EDT and EST, so this must stay a named
# zone rather than a fixed offset.
CFB_TIMEZONE="America/New_York"
CFB_SEASON=2026

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=campusfootball
DB_USERNAME=root
DB_PASSWORD=

# Sessions ride Redis DB 0 (`default`) — NOT the `cache` connection's DB 1,
# because `cache:clear` calls flushdb() on the cache DB and a session sharing
# it would make every cache clear a site-wide logout. In production this flip
# happens in a low-traffic window: moving off the database driver logs
# everyone out exactly once.
SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# HTTPS-only cookies: Herd serves https locally, so this is safe to keep on
# everywhere rather than remembering it per environment.
SESSION_SECURE_COOKIE=true

# Sanctum guards the v1 API that both the web app and the NativePHP client use.
SANCTUM_STATEFUL_DOMAINS=campusfootball.test,localhost,127.0.0.1

# Zero ShouldBroadcast events exist: `reverb` here meant every broadcast()
# call would POST at a host nobody runs. Null until something broadcasts.
BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

# Where user uploads go — brand overrides and avatars. `public` locally;
# `r2` on Laravel Cloud, whose own filesystem is ephemeral and drops an
# upload on the next deploy. The SHIPPED brand in public/brand is in git
# and is read locally either way.
UPLOAD_DISK=public

# Cloudflare R2, via Laravel Cloud's managed bucket.
#
# AWS_URL is the bucket's PUBLIC hostname and is not optional: the S3 endpoint
# below is authenticated, so without it Storage::url() composes a URL that 401s
# on every image. Laravel Cloud does NOT inject this one automatically even for
# a public bucket — copy it from the bucket settings page, or point it at a CDN
# hostname of your own. It is the only thing that decides what an asset URL
# looks like, so swapping in cdn.campusfootball.net is this one line.
#
# Filament's upload writes to Livewire's temporary disk FIRST and moves the
# file on a second request, which on a multi-instance deploy can be a
# different container — so that has to point at the bucket too.
#
# For local uploads against the real bucket, add http://campusfootball.test to
# the bucket's "Allowed origins" in Laravel Cloud; only the environment's own
# domains are in the CORS policy by default.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false
LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=

CACHE_STORE=redis
# Namespaced so a shared Valkey instance can never collide with the old app's keys.
CACHE_PREFIX=campusfootball_cache_

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Finite timeouts, in seconds, on every Redis connection. Unset, phpredis
# falls back to PHP's `default_socket_timeout` of SIXTY — which production
# spent, three times in two nights, holding a request worker open on
# /games/{game} before throwing a RedisException out of the connector.
#
# A managed cache restarts for updates and a Flex cache sleeps when idle, so a
# stalled connect is routine. REDIS_MAX_RETRIES and the backoff below are what
# ride that out, and they cannot start until the first attempt gives up.
# Nothing here issues a blocking Redis command, so a slow read is a stall.
REDIS_TIMEOUT=3
REDIS_READ_TIMEOUT=5

# Laravel Pulse — application monitoring, self-hosted, in our own MySQL.
#
# Recorders push onto a Redis stream and `pulse:work` drains it to MySQL out of
# band, so nothing about telemetry rides the request path. Redis LOCALLY TOO:
# an ingest driver that differs only in production is a bug you cannot
# reproduce. `pulse` is Redis DB 2 (see config/database.php) — its own
# database, because `cache:clear` flushes DB 1 and buffered telemetry must not
# be collateral damage of a routine clear.
#
# `pulse:work` must be running or nothing reaches MySQL, and a stalled drain
# looks exactly like "no traffic". Locally it rides `composer dev`; in
# production it is a Cloud daemon.
#
# The dashboard is at /pulse, gated on User::isAdmin() by the `viewPulse` gate.
PULSE_INGEST_DRIVER=redis
PULSE_REDIS_CONNECTION=pulse
# The dashboard's own result cache is the ARRAY store, not our Redis cache.
# Pulse caches card results as objects, and `cache.serializable_classes => false`
# (Laravel 13's gadget-chain default, and the mechanism behind our own
# "never cache a non-scalar" rule) hands every object back as
# __PHP_Incomplete_Class. See config/pulse.php for the full reasoning.
PULSE_CACHE_DRIVER=array

REVERB_APP_ID=campusfootball
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="campusfootball.test"
REVERB_PORT=443
REVERB_SCHEME=https

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Cloudflare Email Service in production — MAIL_MAILER=cloudflare, plus the two
# credentials below. Sending to arbitrary recipients needs the Workers Paid plan
# and a verified sending domain. CLOUDFLARE_KEY is an API token scoped to email
# sending, NOT the global API key.
#
# Locally this stays on `log`, where mail lands in storage/logs and nothing
# leaves the machine.
MAIL_MAILER=log
# The FROM address must sit on the domain onboarded in Cloudflare Email Service
# — the apex is NOT the sending domain. A mismatch is rejected as
# `email.sending.error.email.invalid` (code 10202), which names neither the
# address nor the reason it is wrong.
MAIL_FROM_ADDRESS="noreply@mail.campusfootball.net"
MAIL_FROM_NAME="${APP_NAME}"

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_KEY=

# The Brevo SMTP relay, kept as a rollback. Cloudflare Email Service is young
# (public beta, April 2026), and with these still set `MAIL_MAILER=smtp` moves
# mail back to a known-good path without a deploy. MAIL_USERNAME is the Brevo
# LOGIN EMAIL; MAIL_PASSWORD is an SMTP key, not the account password. Read only
# by the `smtp` mailer — the Cloudflare transport ignores all four.
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null

# Emails a day we will spend on mail nobody asked for individually.
#
# Starts LOW because Cloudflare gives a new account a deliberately conservative
# daily quota and raises it as sending reputation builds — so the first
# newsletter is the run most likely to meet a ceiling. ThrottleMail releases
# rather than fails, so anything over the budget arrives tomorrow instead of
# erroring. Raise this as the account settles.
MAIL_DAILY_BUDGET=100

# Vonage — SMS. VONAGE_SMS_FROM must be a number on an APPROVED A2P 10DLC
# campaign: US carriers block unregistered senders, and they do it silently, so
# an unapproved number looks like a delivery that simply never lands.
VONAGE_KEY=
VONAGE_SECRET=
VONAGE_SMS_FROM=

# Messages a day, same reasoning as MAIL_DAILY_BUDGET but with teeth: SMS is the
# first channel here that costs real money per message, so a runaway loop is a
# bill rather than a rate-limit warning.
SMS_DAILY_BUDGET=200

# Web push — VAPID identifies this app to the browsers' push services.
# Generate the pair with `php artisan webpush:vapid` (it writes them here).
# The PUBLIC key ships to the browser inside Blade; the PRIVATE key signs
# every send and is a real secret. Rotating them silently orphans every
# existing subscription, so treat them like a signing cert, not a password.
# VAPID_SUBJECT is a mailto: the push services can reach if we misbehave.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

VITE_APP_NAME="${APP_NAME}"

# Flux Pro is licensed, and its credentials live in auth.json (gitignored),
# not here. On a fresh checkout run:
#   php artisan flux:activate <email> <license-key>
# composer.json already carries the flux-pro repository entry.

# Pick'em launch. false keeps the real surfaces to admins and everyone else on
# the coming-soon screen; true opens them to every signed-in user. Run
# `php artisan pickem:preflight` first, and `php artisan pennant:purge pickem`
# AFTER flipping — Pennant persists resolved values, so anybody who already
# loaded a page keeps their old answer until those rows are cleared.
PICKEM_OPEN=false

# Whether a pick reminder may also go out by SMS. The path is wired, tested and
# budget-throttled; it is off because a recurring weekly text costs money and
# invites carrier complaints in a way an email does not. Email and web push
# carry the reminder without it.
PICKEM_REMINDER_SMS=false

# THE AI LAYER. Off, and shipped that way — every surface asks
# App\Support\AiBudget::allows() before spending, and AI_ENABLED is the first
# half of that answer. The two feature flags are Pennant closures reading these
# values, so flipping one is an environment change with an instant rollback —
# run `php artisan pennant:purge ai-answers` (or ai-recaps) AFTER, because the
# database driver persists a resolved value.
# COLLEGE GAMEDAY. promo.espn.com/collegegameday/ is JavaScript-hydrated, so
# fetching the page returns only ESPN's footer — it hydrates from an index.json
# behind it that carries two weeks of locations. That path was read from a
# browser's network tab rather than derived, so it is configured rather than
# guessed: unset, `cfb:gameday` reports the feed unconfigured and stops instead
# of trying a plausible URL and interpreting the 404.
GAMEDAY_FEED_URL=

# The Claude API key the AI layer spends against, scoped to the
# `campus-football` Console workspace so a per-project spend limit applies.
# Use a DIFFERENT key locally and in production, so either can be rotated
# alone. laravel/ai reads it through config/ai.php; nothing calls out while
# AI_ENABLED is false, whatever is set here.
ANTHROPIC_API_KEY=

AI_ENABLED=false
AI_ANSWERS=false
AI_RECAPS=false

# What the AI layer may spend in a calendar month, in US dollars. The budget is
# OURS, not theirs — the Console's own spend limit is the outer wall and it
# arrives as an HTTP error mid-request; this one declines a call before it is
# made, while there is still deterministic content to serve instead. 25 against
# a projected ~$9 at pilot scale: the headroom is for a retry storm, not for
# steady state. Zero or less means uncapped.
AI_MONTHLY_BUDGET=25

# The maintenance advisor's shared secret — the only externally-reachable
# surfaces the AI layer adds, /ops/telemetry (read) and /ops/workbook (write).
#
# The advisor is a Claude Code routine in somebody else's cloud with no
# database access, so a bearer secret is the whole authentication. Run
# `php artisan cfb:advisor-setup` — it prints a token to paste here, and once
# one is set it prints the SIGNED telemetry URL the routine needs. That URL
# cannot be typed: it carries an APP_KEY-derived signature and differs per
# environment.
#
# UNSET MEANS OFF: both routes 404 rather than 403, because an ops surface
# nobody configured should not announce itself. A token under 32 characters
# counts as unset for the same reason.
#
# Never commit it, and use a DIFFERENT one per environment — a token that works
# against production from a laptop is a token that will eventually be pasted
# somewhere it should not be.
OPS_TOKEN=

# The secret GitHub signs its webhook bodies with, so a merged pull request can
# close its own issue.
#
# UNSET MEANS OFF, the same as OPS_TOKEN: /ops/github 404s, and merging simply
# does not move a card — which is the pre-webhook behavior and is safe to sit
# in. Under 32 characters counts as unset.
#
# It must match the secret on the repository's webhook exactly. GitHub signs
# the RAW body, so there is no way to be half-configured: either the HMAC
# verifies or every delivery is a 401.
GITHUB_WEBHOOK_SECRET=

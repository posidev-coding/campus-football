APP_NAME="Campus Football"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://campusfootball.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=UTC

# All contest scheduling, locking, and slate eligibility is evaluated in this
# zone, never in UTC. CFB season spans EDT and EST, so this must stay a named
# zone rather than a fixed offset.
CFB_TIMEZONE="America/New_York"
CFB_SEASON=2026

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=campusfootball
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Sanctum guards the v1 API that both the web app and the NativePHP client use.
SANCTUM_STATEFUL_DOMAINS=campusfootball.test,localhost,127.0.0.1

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# Namespaced so a shared Valkey instance can never collide with the old app's keys.
CACHE_PREFIX=campusfootball_cache_

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

REVERB_APP_ID=campusfootball
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="campusfootball.test"
REVERB_PORT=443
REVERB_SCHEME=https

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@campusfootball.net"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Flux Pro license (https://fluxui.dev). The free tier works without this;
# the Pro component set does not.
FLUX_USERNAME=
FLUX_LICENSE_KEY=
